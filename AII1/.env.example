# Frontend environment variables
# Copy this file to .env.local and fill in the real values.
# NEVER commit .env.local — it is excluded by .gitignore.

# Supabase project URL — Supabase dashboard → Settings → API → URL
VITE_SUPABASE_URL=

# Supabase anon/public key — Supabase dashboard → Settings → API → anon/public
VITE_SUPABASE_ANON_KEY=

# Optional: override backend API base URL (leave empty in dev — Vite proxy handles /api/*)
VITE_API_BASE_URL=
