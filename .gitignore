# Root .gitignore for InterviewPrep AI

# Dependencies
node_modules/
*/node_modules/

# Production builds
dist/
*/dist/

# Environment files and secrets - NEVER commit
.env
.env.*
!.env.example
*/.env
*/.env.*
!*/.env.example

# Logs and OS noise
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.DS_Store
Thumbs.db

# Test coverage
coverage/
*/coverage/
