# Server environment variables
# Copy this file to .env and fill in the real values.
# NEVER commit .env — it is excluded by .gitignore.

# Gemini API key — get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Supabase project URL (same as the frontend VITE_SUPABASE_URL value)
SUPABASE_URL=

# Supabase service_role key — Supabase dashboard → Settings → API → service_role (secret)
# This key bypasses RLS; NEVER expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase anon key — public-safe key for token validation
SUPABASE_ANON_KEY=

# Port the Express server listens on (Vite proxies /api/* here in dev)
PORT=3001

# Comma-separated allowed CORS origins — no trailing slash
# Development: http://localhost:5173,http://localhost:4173
# Production:  https://your-production-domain.com
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# BYOK Credential Encryption Key (AES-256-GCM)
# REQUIRED: 32 random bytes encoded as base64.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NEVER commit this key. If it changes, all saved BYOK credentials become unreadable.
CREDENTIAL_ENCRYPTION_KEY=
